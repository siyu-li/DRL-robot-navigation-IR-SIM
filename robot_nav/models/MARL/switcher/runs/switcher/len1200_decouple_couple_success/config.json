{
  "data_path": "robot_nav/models/MARL/switcher/data/oracle_data_14robots_decouple_couple_group_len1200_success.pt",
  "embed_dim": 512,
  "max_group_size": 7,
  "rotation_coupling_threshold": 3,
  "extra_group": [
    [
      "dist_to_goal",
      "mean"
    ],
    [
      "dist_to_goal",
      "min"
    ],
    [
      "clearance",
      "min"
    ],
    [
      "reached",
      "mean"
    ],
    [
      "heading_error",
      "mean"
    ]
  ],
  "extra_global": [
    "var_dist_goal_global",
    "frac_reached_global",
    "steps_elapsed_frac"
  ],
  "use_urgency_flag": false,
  "embed_hidden": 256,
  "scalar_hidden": 64,
  "fusion_hidden": 256,
  "dropout": 0.1,
  "epochs": 100,
  "batch_size": 64,
  "lr": 0.0003,
  "weight_decay": 0.0001,
  "loss_type": "logistic",
  "hinge_margin": 1.0,
  "val_split": 0.1,
  "eval_every": 5,
  "save_dir": "robot_nav/models/MARL/switcher/runs/switcher",
  "save_every": 10,
  "device": "cuda"
}